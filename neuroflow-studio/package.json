{
  "name": "neuroflow-studio",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --dev-client --lan",
    "build:ios": "npx eas-cli build --platform ios --profile development",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:replay": "tsc --strict --noUncheckedIndexedAccess --target es2022 --module commonjs --skipLibCheck --outDir .test-build src/replay.ts src/replay.test.ts && node .test-build/replay.test.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.22",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
